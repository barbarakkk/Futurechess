{
  "name": "chesshub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "start": "npm run start -w server",
    "build": "npm run prisma:generate -w server && npm run prisma:deploy -w server",
    "railway:push-env": "node server/scripts/push-env-to-railway.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "allowScripts": {
    "prisma@7.7.0": true,
    "stockfish@18.0.7": true,
    "@prisma/engines@7.7.0": true
  }
}
