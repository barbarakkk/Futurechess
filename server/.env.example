# Server runtime
PORT=4000
JWT_SECRET=replace_with_a_long_random_secret

# Supabase Postgres connection used by Prisma client/runtime
DATABASE_URL=postgresql://postgres:<PASSWORD>@<PROJECT>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Optional: direct non-pooled URL used by Prisma migrations
# If omitted, Prisma falls back to DATABASE_URL (see prisma.config.ts)
DIRECT_URL=postgresql://postgres:<PASSWORD>@<PROJECT>.supabase.co:5432/postgres

# Coach booking notification emails (https://resend.com)
# If unset, emails are skipped with a console warning instead of failing the request.
RESEND_API_KEY=
EMAIL_FROM="ChessHub <onboarding@resend.dev>"

# Public base URL of the frontend — used to build links embedded in emails
# (e.g. the coach accept/decline booking links)
CLIENT_URL=http://localhost:5173

# Site owner's inbox — receives coach-application notifications with
# approve/reject links. If unset, applications are still recorded but
# no admin email is sent (a warning is logged instead).
ADMIN_EMAIL=
